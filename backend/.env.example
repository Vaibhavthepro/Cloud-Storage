# Server Port
PORT=3000
NODE_ENV=development

# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/cloud_storage

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL
FRONTEND_URL=https://cloud-storage-frontend-faa8.onrender.com

# Storage Provider Selection (supabase | local | r2)
STORAGE_PROVIDER=supabase

# Supabase Storage Configuration (ACTIVE Production Provider)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_STORAGE_BUCKET=cloud-storage-files

# (Optional) Cloudflare R2 Object Storage Configuration (Disabled / Future Use)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# Quotas and Upload Limits
MAX_FILE_SIZE=5368709120
CHUNK_SIZE=10485760
DEFAULT_STORAGE_QUOTA=10737418240
