# Application Config
APP_ENV=production
API_PORT=3000

# Security
JWT_SECRET=super_secure_production_secret_key

# Database
# Connects to the docker-compose 'db' service
DATABASE_URL=postgresql://root:rootpassword@db:5432/cloud_storage?schema=public

# Postgres Initialization
POSTGRES_USER=root
POSTGRES_PASSWORD=rootpassword
POSTGRES_DB=cloud_storage

# ClamAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here